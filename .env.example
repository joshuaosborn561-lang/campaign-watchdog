# Smartlead
SMARTLEAD_API_KEY=

# Slack — bot token, or rotating access + refresh tokens
SLACK_BOT_TOKEN=
SLACK_ACCESS_TOKEN=
SLACK_REFRESH_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CHANNEL_ID=C0BT978GSAC
# Pulse *under* mentions (defaults are Cayden + Josh). Set on Railway only to override.
# SLACK_CAYDEN_USER_ID=U0BL8JT75KN
# SLACK_JOSH_USER_ID=U0AAX2XFJE7

# campaignintelligence (client names + alert dedupe)
SUPABASE_URL=https://azpapwtnrbzywlnxxecz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Watcher
MESSAGE_PER_DAY=30
MAILBOX_MIN_TIME_GAP_MINS=10
# 50 is recorded in state but never Slacked. 75/90 = refill soon. 100 = finished.
COMPLETION_THRESHOLDS=50,75,90,100
SEND_SHORTFALL_AFTER_HOUR=17
SEND_SHORTFALL_TIMEZONE=America/Chicago
BOUNCE_AUTO_PAUSE_THRESHOLD=5
MIN_BOUNCE_SAMPLE=20
CRON=*/15 * * * *
# Slack: weekday 2h pulse, midday volume, autobounce, 75/90/100, HeyReach runway, EOD.
# Pulse is weekday-only (Mon–Fri). Off track / nightly digest still do not post.
PULSE_CRON=5 8,10,12,14,16 * * 1-5
PULSE_HOURS=8,10,12,14,16
PULSE_WEEKDAYS=1,2,3,4,5
VOLUME_CRON=10 12 * * 1-5
VOLUME_HOUR=12
VOLUME_WEEKDAYS=1,2,3,4,5
VOLUME_TARGET_SENDS=1200
VOLUME_ALERT_MAX=1080
EOD_CRON=30 17 * * 1-5
EOD_HOUR=17
# Mute filter for pulse/midday/EOD (does not pause/stop/delete Smartlead campaigns).
# Built-in defaults hide the legacy Nieto/MSRS/Positive leftovers.
# PULSE_EXCLUDE_CAMPAIGN_IDS=3437329,3628940,3628943,3867914,3867917
# PULSE_EXCLUDE_CAMPAIGN_NAMES=MSRS Ticket Offer Propert Manager,Positive
WATCH_STATUSES=ACTIVE,PAUSED
ALERT_EXISTING_AUTOBOUNCE=0

# HTTP
PORT=3000
HOST=0.0.0.0
# Optional shared secret for POST /run (header X-Run-Token)
RUN_TOKEN=

# Persist last-seen campaign state (mount a Railway volume at /data in production)
STATE_FILE_PATH=/data/watchdog-state.json

# HeyReach LinkedIn runway — workspace API keys only (Railway env, not vault).
# Do not set HEYREACH_MASTER_API_KEY (org key; public API returns 401).
HEYREACH_SALESGLIDER_API_KEY=
HEYREACH_TECHEVO_API_KEY=
# Optional JSON map instead of / in addition to the keys above:
# HEYREACH_WORKSPACES={"SalesGlider":"...","TechEvo":"..."}
# HeyReach runway Slack is weekdays only (same 15-minute watch).
HEYREACH_ALERT_EXCLUDE_IDS=530529
HEYREACH_RUNWAY_DAYS=7
HEYREACH_PACE_LOOKBACK_DAYS=14
HEYREACH_WEEKDAYS=1,2,3,4,5
